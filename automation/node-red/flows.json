  {
    "id": "1664395627624b20",
    "type": "function",
    "z": "171f574033694a86",
    "name": "Un mensaje por hotel",
    "func": "const hoteles = Array.isArray(msg.payload) ? msg.payload : [];\nif (hoteles.length === 0) { node.warn('Ningún hotel tiene telegram_chat_id registrado'); return null; }\n// Regresar [arreglo] manda varios mensajes por la misma salida\nreturn [hoteles.map((h) => ({ payload: { chatId: h.chat, type: 'message', content: h.texto } }))];",
