  {
    "id": "230e6f48bf054cf5",
    "type": "function",
    "z": "171f574033694a86",
    "name": "Preparar consulta",
    "func": "// Solo mensajes de texto (se ignoran fotos, stickers, etc.)\nif (msg.payload.type !== 'message' || typeof msg.payload.content !== 'string') return null;\n\n// Parámetros $1, $2, $3 de la consulta: nunca se pegan al SQL (evita inyección SQL)\nmsg.params = [\n  msg.payload.content.slice(0, 200),\n  String(msg.payload.chatId),\n  msg.originalMessage?.from?.first_name ?? null,\n];\nmsg.chatId = msg.payload.chatId;\nreturn msg;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 340,
    "y": 100,
